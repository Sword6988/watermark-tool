# ---- Build artifacts (large, regenerable) ----
dist/
build/
_obsolete/
selftest_out/
# 手动"回收站"：不再分发的旧产物先移到这里（零 rm、可还原），确认无用后再清空
_trash/
# audit scratch (incl. large sample PDFs) — keep _smoke/verify_exe_bytes.py? excluded for a clean repo
_smoke/
# tools/verify_onefile.py 的运行目录：会复制一份 32MB exe 进去并产出自检报告
tools/_one_alone/
__pycache__/
*.pyc
*.pyo

# ---- Binaries ----
# 默认不放行任何 exe（构建产物、随手丢进来的第三方程序）。
*.exe
# 唯一例外：随包分发的 LDDec 解密器，它是运行期依赖，必须进版本库。
# 校验和见 tools/LDDec/SHA256.txt，来源记录见 docs/integration-lddec.md。
!tools/LDDec/dec.exe

# ---- Virtual environments ----
.venv/
venv/

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp

# ---- WorkBuddy project-local data (not source) ----
.workbuddy/
